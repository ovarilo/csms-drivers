{
  "name": "@ovarilo/csms-drivers",
  "version": "0.1.0",
  "description": "Reusable CSMS driver library: typed OCPP 1.6 and 2.0.1 operation contracts, charge-point administration, SteVe and CitrineOS drivers, and an HTTP/JSON handler over any driver.",
  "keywords": [
    "ocpp",
    "ocpp-1.6",
    "ocpp-2.0.1",
    "csms",
    "steve",
    "citrineos",
    "ev-charging",
    "bun"
  ],
  "homepage": "https://github.com/ovarilo/csms-drivers#readme",
  "bugs": "https://github.com/ovarilo/csms-drivers/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovarilo/csms-drivers.git"
  },
  "license": "Apache-2.0",
  "author": "Julien Herr",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src/",
    "types/",
    "tsconfig.base.json",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./types/server/index.d.ts",
      "default": "./src/server/index.ts"
    },
    "./tsconfig": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bash scripts/boundary.sh && bash scripts/types-current.sh && bun tests/csms-driver-factories.ts && bun tests/csms-driver-charge-points.ts && bun tests/csms-server.ts && bun examples/csms-driver-smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  }
}
