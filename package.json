{
  "name": "@ovarilo/csms-drivers",
  "version": "0.0.2",
  "description": "Reusable CSMS driver library: typed OCPP 1.6 and 2.0.1 operation contracts, charge-point administration, SteVe and CitrineOS drivers, and an HTTP/JSON handler over any driver.",
  "keywords": [
    "ocpp",
    "ocpp-1.6",
    "ocpp-2.0.1",
    "csms",
    "steve",
    "citrineos",
    "ev-charging",
    "bun"
  ],
  "homepage": "https://github.com/ovarilo/csms-drivers#readme",
  "bugs": "https://github.com/ovarilo/csms-drivers/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovarilo/csms-drivers.git"
  },
  "license": "Apache-2.0",
  "author": "Julien Herr",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.3",
  "files": [
    "src/",
    "dist/",
    "tsconfig.base.json",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "bun": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./steve/api-client": {
      "bun": "./src/steve/api-client.ts",
      "types": "./dist/steve/api-client.d.ts",
      "default": "./dist/steve/api-client.js"
    },
    "./steve/ui-client": {
      "bun": "./src/steve/ui-client.ts",
      "types": "./dist/steve/ui-client.d.ts",
      "default": "./dist/steve/ui-client.js"
    },
    "./steve/forms": {
      "bun": "./src/steve/forms.ts",
      "types": "./dist/steve/forms.d.ts",
      "default": "./dist/steve/forms.js"
    },
    "./steve/charge-points": {
      "bun": "./src/steve/charge-points.ts",
      "types": "./dist/steve/charge-points.d.ts",
      "default": "./dist/steve/charge-points.js"
    },
    "./citrineos/api-client": {
      "bun": "./src/citrineos/api-client.ts",
      "types": "./dist/citrineos/api-client.d.ts",
      "default": "./dist/citrineos/api-client.js"
    },
    "./citrineos/config": {
      "bun": "./src/citrineos/config.ts",
      "types": "./dist/citrineos/config.d.ts",
      "default": "./dist/citrineos/config.js"
    },
    "./citrineos/http": {
      "bun": "./src/citrineos/http.ts",
      "types": "./dist/citrineos/http.d.ts",
      "default": "./dist/citrineos/http.js"
    },
    "./citrineos/requests": {
      "bun": "./src/citrineos/requests.ts",
      "types": "./dist/citrineos/requests.d.ts",
      "default": "./dist/citrineos/requests.js"
    },
    "./citrineos/variant": {
      "bun": "./src/citrineos/variant.ts",
      "types": "./dist/citrineos/variant.d.ts",
      "default": "./dist/citrineos/variant.js"
    },
    "./tsconfig": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "test": "bun run build && bash scripts/boundary.sh && bun tests/shared-http.ts && bun tests/csms-driver-factories.ts && bun tests/codetics-ev-server-lite-driver.ts && bun tests/csms-driver-charge-points.ts && bun tests/csms-server.ts && bun tests/release-changelog.ts && bun tests/package-content.ts && bun tests/release-state.ts && bun examples/csms-driver-smoke.ts && bash scripts/package-smoke.sh",
    "check": "vp check && bun run typecheck && bun run test && bun scripts/check-package.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "1.3.14",
    "@types/semver": "7.8.0",
    "semver": "7.8.5",
    "typescript": "5.9.2",
    "vite-plus": "1.3.0"
  }
}
